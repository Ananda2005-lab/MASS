# ============================================================
# LLM Provider Keys — backend/.env ME COPY KARNA (is file ko NAHI)
# Format: PREFIX_1, PREFIX_2, ... (har key apni number ke saath)
# Rotation/failover/quota automatic hai — jitni keys daalo, utna better
# Kam se kam EK provider ki 1 key kaafi hai system chalane ke liye
# ============================================================

# Groq (console.groq.com — FREE tier, fast) — RECOMMENDED pehli key
GROQ_1=
GROQ_2=
# GROQ_3=

# Google AI Studio (aistudio.google.com — FREE tier, vision bhi supported)
GOOGLE_AI_STUDIO_1=
# GOOGLE_AI_STUDIO_2=

# OpenRouter (openrouter.ai — free+paid models dono)
OPENROUTER_1=
# OPENROUTER_2=

# Optional: custom OpenAI-compatible providers (per-key base URL support)
# XKIRO_1=
# XKIROBASE_URL=https://api.xkiro.com/v1
# BAI_AI_1=
# BAI_AIBASE_URL=https://api.b.ai/v1
